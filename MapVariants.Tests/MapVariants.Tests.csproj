<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\MapVariants.Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
    <!-- The maps.json parser has no game reference, so it is tested here as source. -->
    <Compile Include="..\MapVariants.Client\MapsFile.cs" Link="Client\MapsFile.cs" Condition="Exists('..\MapVariants.Client\MapsFile.cs')" />
  </ItemGroup>
</Project>
